<!--
  The welcome card in the browser view, built from the plaque's palette and toggle
  (public/ui/hud.uikitml): a walnut header, a cream body and a brass border.
  PanelSystem (src/panel.ts) renders #xr-button and #xr-note from entryView.
  Notes live in these comments, never inside <style>: a CSS comment there fails the card.
-->
<style>
  .card {
    flex-direction: column;
    width: 344px;
    border-radius: 18px;
    background-color: #f4ead8;
    border-color: #8a6a3c;
    border-width: 3px;
  }

  .header {
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 15px;
    background-color: #3d2f2a;
  }

  .title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #fbf3e4;
  }

  .body {
    flex-direction: column;
    gap: 12px;
    padding-top: 14px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .gesture {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    color: #3d2f2a;
  }

  .toggle {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    background-color: #e3d3b4;
    border-color: #8a6a3c;
    border-width: 2px;
    text-align: center;
    font-size: 17px;
    font-weight: 700;
    color: #3d2f2a;
    cursor: pointer;
  }

  .toggle:hover {
    background-color: #f2c14e;
  }

  .toggle:active {
    background-color: #d9a63a;
  }

  .note {
    display: none;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    color: #8a4b12;
  }
</style>
<div id="welcome-card" class="card">
  <div class="header">
    <span class="title">Threadbound</span>
  </div>
  <div class="body">
    <span class="gesture">
      Pinch a brass peg, pull, and release on another peg to stretch a thread.
      Pinch the chute to drop marbles. Every bounce plays a note.
    </span>
    <!-- A toggle-style span: Enter XR acts on release (onTap), so a press of any length enters. -->
    <span id="xr-button" class="toggle">Enter XR</span>
    <!-- Spans need initial text: UIKit only lays out text that exists at parse time. -->
    <span id="xr-note" class="note">Open in Quest Browser to play in mixed reality</span>
  </div>
</div>
