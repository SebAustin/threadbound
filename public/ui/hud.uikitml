<!--
  Diorama plaque: level title, place in the world, best stars, thread budget.
  Sized in centimetres (scale 1): about 30 cm wide above a 50 cm diorama.
  HudSystem fills every #id below from the puzzle state.
-->
<style>
  .plaque {
    flex-direction: column;
    width: 30;
    border-radius: 1.4;
    background-color: #f4ead8;
    border-color: #8a6a3c;
    border-width: 0.25;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 1.6;
    padding-right: 1.6;
    border-radius: 1.2;
    background-color: #3d2f2a;
  }

  .title {
    font-size: 2.2;
    font-weight: 700;
    color: #fbf3e4;
  }

  .stars {
    flex-direction: row;
    gap: 0.6;
  }

  .star {
    width: 1.6;
    height: 1.6;
    border-radius: 0.8;
    border-color: #d9b45a;
    border-width: 0.25;
    background-color: #3d2f2a;
  }

  .details {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 0.8;
    padding-bottom: 1;
    padding-left: 1.6;
    padding-right: 1.6;
  }

  .hint {
    display: none;
    padding-bottom: 1;
    padding-left: 1.6;
    padding-right: 1.6;
    font-size: 1.5;
    font-weight: 700;
    color: #8a4b12;
  }

  .spool {
    display: none;
    padding-bottom: 0.8;
    padding-left: 1.6;
    font-size: 1.4;
    font-weight: 700;
    color: #3d2f2a;
  }

  .face {
    flex-direction: column;
  }

  .settings-face {
    display: none;
    padding-bottom: 1;
  }

  .toggle {
    margin-top: 0.8;
    margin-left: 1.6;
    margin-right: 1.6;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1.2;
    padding-right: 1.2;
    border-radius: 0.8;
    background-color: #e3d3b4;
    border-color: #8a6a3c;
    border-width: 0.2;
    font-size: 1.5;
    font-weight: 700;
    color: #3d2f2a;
    cursor: pointer;
  }

  .toggle:hover {
    background-color: #f2c14e;
  }

  .detail {
    font-size: 1.4;
    font-weight: 500;
    color: #3d2f2a;
  }
</style>
<div class="plaque">
  <div id="level-face" class="face">
  <div id="hud-header" class="header">
    <span id="hud-title" class="title">Threadbound</span>
    <div class="stars">
      <div id="hud-star-1" class="star"></div>
      <div id="hud-star-2" class="star"></div>
      <div id="hud-star-3" class="star"></div>
    </div>
  </div>
  <div class="details">
    <span id="hud-world" class="detail">World 1 - 1/6</span>
    <span id="hud-threads" class="detail">Threads 0/2 - par 1</span>
  </div>
  <span id="hud-spool" class="spool">Spool</span>
  <!-- Spans need initial text: UIKit only lays out text that exists at parse time. -->
  <span id="hud-hint" class="hint">Hint</span>
  </div>
  <div id="settings-face" class="face settings-face">
    <div class="header">
      <span class="title">Settings</span>
    </div>
    <span id="set-slow" class="toggle">Slow motion: Off</span>
    <span id="set-reset" class="toggle">Reset progress</span>
  </div>
</div>
